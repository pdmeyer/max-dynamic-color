    "ignoreDeprecations": "5.0",
    "lib": [
      "es2022"
    ],
    "module": "CommonJS",
    "noImplicitAny": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false,
    "strict": true,
    "target": "es2022",
    "types": [
      "@types/maxmsp"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
